
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransferInitiated",
  "type": "object",
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "enum": ["transfer.initiated"] },
    "event_version": { "type": "string", "example": "1.0" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "example": "m1-gateway" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "data": {
      "type": "object",
      "properties": {
        "transfer_id": { "type": "string", "format": "uuid" },
        "sender_wallet_id": { "type": "string" },
        "receiver_wallet_id": { "type": "string" },
        "amount_minor": { "type": "integer", "description": "Amount in paisa" },
        "currency": { "type": "string", "enum": ["PKR"] }
      },
      "required": ["transfer_id", "sender_wallet_id", "receiver_wallet_id", "amount_minor", "currency"]
    }
  },
  "required": ["event_id", "event_type", "event_version", "occurred_at", "correlation_id", "data"]
}